<?xml version="1.0" encoding="utf-8"?>
<!--
  updatePeriodMillis is 0 on purpose: the service redraws the widget when the
  speaker actually changes, rather than the platform waking the app on a timer.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="64dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_now_playing"
    android:previewImage="@mipmap/ic_launcher"
    android:previewLayout="@layout/widget_now_playing"
    android:resizeMode="horizontal"
    android:widgetCategory="home_screen"
    android:description="@string/widget_bar_description" />
