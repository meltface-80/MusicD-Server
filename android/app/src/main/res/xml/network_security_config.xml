<?xml version="1.0" encoding="utf-8"?>
<!--
  MusicD Server is plain HTTP on your own network — there is no certificate a
  home server could present — so cleartext has to be allowed. Nothing it
  carries leaves the local network.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
